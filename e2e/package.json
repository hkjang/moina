{
  "name": "moina-browser-e2e",
  "private": true,
  "version": "0.1.15",
  "type": "module",
  "scripts": {
    "test": "npm run test:visual && npm run test:accessibility && npm run test:smoke",
    "test:smoke": "node browser-smoke.mjs",
    "test:accessibility": "node accessibility-regression.mjs",
    "test:visual": "node visual-regression.mjs",
    "visual:update": "MOINA_UPDATE_VISUALS=1 node visual-regression.mjs",
    "capture": "node capture-pages.mjs",
    "capture:web": "node capture-pages.mjs && node optimize-screenshots.mjs",
    "serve:pages": "node pages-server.mjs",
    "test:pages": "node pages-smoke.mjs"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "playwright": "1.62.1"
  }
}
