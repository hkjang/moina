# moina가 읽는 런타임 환경변수는 아래 네 개뿐입니다.
MOINA_POSTGRES_DSN=postgres://moina:change-me@postgres.internal:5432/moina?sslmode=verify-full
MOINA_BOOTSTRAP_ADMIN=admin
MOINA_BOOTSTRAP_ADMIN_PASSWORD=change-this-bootstrap-password
# 32바이트 무작위 키의 base64 값: openssl rand -base64 32
MOINA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
